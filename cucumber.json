{
    "default": {

        "dryRun": false,

        "formatOptions": {
            "snippetInterface": "async-await"
        },

        "paths": [
            "src/tests/features/**/*.feature"
        ],
        "require": [
            "src/tests/hooks/hooks.ts",
            "src/tests/stepdefinations/**/*.steps.ts"
        ],
        "requireModule": [
            "ts-node/register"
        ],
        
        "publishQuiet": true,
        "parallel": 1,
        "retry": 0,
        
        
        "format": [
            "progress-bar",
            "json:reports/cucumber-report.json",
            "html:reports/cucumber-report.html"
        ]
    }
}